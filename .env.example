# LLM providers: generator and judge MUST be different
GENERATOR_PROVIDER=openai
JUDGE_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-2.0-flash

# Embeddings (multilingual, good Arabic support)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Storage
DATABASE_URL=sqlite:///midya.db

# Buffer (leave empty + DRY_RUN=true to test safely)
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_IDS=
DRY_RUN=true

# Publishing policy
AUTO_PUBLISH=false
